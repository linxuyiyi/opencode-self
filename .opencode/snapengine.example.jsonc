{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "snapengine": {
      "name": "SnapEngine",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "snapURL": "http://your-snapengine-host/api/v2/chat/completions",
        "timeout": 180000,
        "headerTimeout": 180000,
        "chunkTimeout": 180000
      },
      "models": {
        "Qwen3.6-27B-SHR-VL": {
          "name": "Qwen3.6-27B-SHR-VL",
          "tool_call": true
        },
        "GLM-5.2-Tester": {
          "name": "GLM-5.2-Tester",
          "tool_call": true
        },
        "GLM-5.1-Tester": {
          "name": "GLM-5.1-Tester",
          "tool_call": true
        },
        "GLM4.7-Tester": {
          "name": "GLM4.7-Tester",
          "tool_call": true
        },
        "MiniMax-M2.7": {
          "name": "MiniMax-M2.7",
          "tool_call": true
        },
        "Glm-5.1": {
          "name": "Glm-5.1",
          "tool_call": true
        }
      }
    }
  },
  "model": "snapengine/GLM-5.2-Tester"
}
